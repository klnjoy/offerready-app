# Copy to .env.local and adjust. All values are optional; defaults match the
# current MkDocs site (content/assets/api-config.js).

# Where `npm run dev` proxies /api to. Point at a local `vercel dev` (e.g.
# http://localhost:3000) to work against your own backend.
VITE_API_PROXY_TARGET=https://offerready-beta.vercel.app

# API base the browser calls. Leave empty locally (the dev proxy above handles
# /api). The GitHub Pages build sets it to https://offerready-beta.vercel.app.
VITE_API_BASE=

# Path the app is served from. "/" locally; the GitHub Pages build uses
# /offerready-app/.
VITE_BASE=/

# Set to "false" to run without a backend (sample analysis + bundled scenarios).
VITE_API_ENABLED=true

# Supabase publishable (anon) key only — never the service-role key.
VITE_SUPABASE_URL=https://qelqtqgypwzduauiudbg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_J-_TcxztkDSld8jSqTcmMQ_cBniHoaT

# The MkDocs study site. Resource links and the practice question bank load from here.
VITE_DOCS_BASE=https://klnjoy.github.io/offerready/

# Pro price label shown on /pricing and upgrade cards (display only; Stripe
# charges whatever STRIPE_PRO_MONTHLY_PRICE_ID is). Default: "$12 / month".
# Escape the dollar sign in .env files (Vite expands $NAME references); in a
# CI/GitHub Actions env var write it plainly.
# VITE_PRO_PRICE_LABEL=\$12 / month

# Optional: support email shown in the pricing FAQ for cancel-by-email.
VITE_SUPPORT_EMAIL=
